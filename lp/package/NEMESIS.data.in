[nemesis]
version=1.2
id=jmk-autoplay-hud
name=JMK AutoPlay 확장 (HUD · 계기판 길안내)
types=application,service
package-version=@VERSION@
short-desc="Wireless CarPlay bridge and phone turn-by-turn on cluster/HUD"
detailed-desc="The CarPlay Bluetooth bridge for wireless CarPlay, and Android Auto / CarPlay turn-by-turn on the stock cluster and HUD, rebuilt on the head unit from its own stock files (projection.tbt, HMG Leafia Plus). LivePatch build. AGPL-3.0."
os="*.KOR.*"
models=any
depends="jmk-autoplay@>=0.5.0,usb-handler@>=1.17,!danpung,!enhanced.projection,!wireless.carplay.aa"
preinstall=scripts/preinstall.sh
postinstall=scripts/postinstall.sh
preuninstall=scripts/preuninstall.sh
# licence: AGPL-3.0 (LICENSE); lpatch: GPL-3.0 (LICENSES/GPL-3.0.txt); source: https://github.com/JongMinKim-93/jmk-autoplay-hud

[app.0]
kind=sh
path=bin/launch.sh
uid=root

[service.0]
name=settings
kind=sh
path=svc/hud.sh
uid=root
mode=background

# LivePatch (NEMESIS 1.17): one exec step per stock file. tools/hud-step reads the stock file it is given (and this unit's other stock files),
# chooses the profile this firmware's code fits and gives back the rebuilt file; NEMESIS mounts it at the next boot and takes it down on uninstall.
# The sections below are written by build_lp_package.py from the profiles' manifests, never by hand.
