[nemesis]
version=1.1
id=jmk-autoplay-hud
name=JMK AutoPlay 확장 (HUD · 계기판 길안내)
types=application,service
package-version=0.1.4
short-desc="Wireless CarPlay bridge and phone turn-by-turn on cluster/HUD"
detailed-desc="The CarPlay Bluetooth bridge for wireless CarPlay, and Android Auto / CarPlay turn-by-turn on the stock cluster and HUD, rebuilt on the head unit from its own stock files (projection.tbt + HMG Leafia Plus). Needs JMK Wireless AutoPlay. AGPL-3.0."
os="*.KOR.*"
models=any
depends="jmk-autoplay"
preinstall=scripts/preinstall.sh
postinstall=scripts/postinstall.sh
preuninstall=scripts/preuninstall.sh
# licence: AGPL-3.0 (LICENSE); lpatch: GPL-3.0 (LICENSES/GPL-3.0.txt); source: https://github.com/JongMinKim-93/jmk-autoplay-hud

[app.0]
kind=sh
path=bin/launch.sh
uid=root

[service.0]
name=settings
kind=sh
path=svc/hud.sh
uid=root
mode=background
